# Server port
PORT=5000

# Frontend URL, used for CORS
CLIENT_URL=http://localhost:5173

# PostgreSQL connection (self-hosted on your VPS, or any Postgres instance)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://fennec_user:changeme@localhost:5432/fennec_club
# Set to "true" only if your Postgres requires SSL (most managed providers do, a local VPS install usually doesn't)
DATABASE_SSL=false

# JWT settings used to sign and verify login sessions
# Generate a strong secret, e.g.: openssl rand -base64 48
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d
